<Project>
    <!-- build.yaml is the one place a release version is written. The packaging
         tool already reads it from there and stamps the build with it, so a
         version restated here was a second copy that a plain `dotnet build`
         used and a packaged build ignored, and the two disagreed silently.

         The read is a regular expression rather than a YAML parser because
         MSBuild has no YAML, and adding one to the build would be a dependency
         for one field. If the expression stops matching, the replacement
         returns the whole file and the build fails on an unusable version
         rather than falling back to a wrong one. ManifestTests asserts the
         stamped version and the manifest agree, so a silent disagreement is
         refused by the suite rather than left to be noticed.

         The read is nested inside the match rather than held in a property
         first. A property holding the file text is expanded as argument text
         before the function is parsed, so the first comma or apostrophe in the
         description would split the arguments and break the build for a reason
         nowhere near the edit that caused it. Nested, the text is passed as a
         value and never re-read as MSBuild syntax. -->
    <PropertyGroup>
        <!-- The graph is watched, not only recorded. NuGet checks the restored graph
             against the advisory database and NU1901 to NU1904 are raised to errors, so a
             known-vulnerable package fails the restore. Left as warnings they would be
             true and green, printed into a log nobody reads.
    
             This board committed a lockfile and ran no audit, which is the worse half of
             the pair: the graph was held still and nothing looked at it. Eleven boards of
             this fleet were in that state on 2026-08-18, and the twelfth is why it
             matters. jellyfin-plugin-watchlist was told by Scorecard about one high
             advisory; switching this on found a second one rated critical that Scorecard
             had never reported.
    
             Mode all rather than direct: both of those arrived under the Jellyfin
             packages and neither was referenced by a project file, so a direct-only audit
             would have found neither.
    
             Nothing is pinned here. Measured with the audit forced on from the command
             line, this board reports no advisory today; the entry is the detector, not a
             repair.
    
             Note for whoever edits this comment: an XML comment may not contain two
             hyphens in a row. A draft elsewhere in this fleet spelled out a command line
             flag, left the file malformed, and the build failed on a property defined
             twenty lines below. -->
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAuditLevel>low</NuGetAuditLevel>
        <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <Version>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)build.yaml')), '(?s)^.*?[\r\n]version:[ \t]*"([^"]*)".*$', '$1'))</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
    </PropertyGroup>

    <!-- Locked restore, for every project and every route. Without it a restore
         resolves the newest matching version of every transitive package, so a
         pull request is reviewed against a graph that moves underneath it and a
         compromised transitive release lands with no diff.

         The shared build and test workflows run a plain `dotnet restore`, and
         this repository cannot pass a flag to them, so the property carries the
         locked mode instead and both routes behave the same.

         The cost, stated rather than discovered: changing a package version now
         fails the restore until the lock file is regenerated, with
         `dotnet restore /p:RestoreForceEvaluate=true`. That is the guard
         working. -->
    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode>true</RestoreLockedMode>
    </PropertyGroup>

    <!-- Analysis, for every project this repository has and every one it adds.
         These three sat in the plugin project file, which covered one project
         out of two the moment the test project existed. A test project outside
         the analyzer set is where an unsafe pattern is written first and copied
         second, and nothing about it looks wrong in review.

         AnalysisMode is the switch that is never lowered. A rule that genuinely
         does not fit is turned off by name in jellyfin.ruleset with the reason
         written at it, so the next reader can disagree with one rule instead of
         guessing why the whole category is quiet.

         Nullable is here for the same reason and CS8600 upward are warnings
         that TreatWarningsAsErrors makes fatal. -->
    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
        <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)jellyfin.ruleset</CodeAnalysisRuleSet>
        <Nullable>enable</Nullable>
    </PropertyGroup>
</Project>
