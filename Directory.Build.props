<Project>
    <!-- build.yaml is the one place a release version is written. The packaging
         tool already reads it from there and stamps the build with it, so a
         version restated here was a second copy that a plain `dotnet build`
         used and a packaged build ignored, and the two disagreed silently.

         The read is a regular expression rather than a YAML parser because
         MSBuild has no YAML, and adding one to the build would be a dependency
         for one field. If the expression stops matching, the replacement
         returns the whole file and the build fails on an unusable version
         rather than falling back to a wrong one. ManifestTests asserts the
         stamped version and the manifest agree, so a silent disagreement is
         refused by the suite rather than left to be noticed.

         The read is nested inside the match rather than held in a property
         first. A property holding the file text is expanded as argument text
         before the function is parsed, so the first comma or apostrophe in the
         description would split the arguments and break the build for a reason
         nowhere near the edit that caused it. Nested, the text is passed as a
         value and never re-read as MSBuild syntax. -->
    <PropertyGroup>
        <Version>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)build.yaml')), '(?s)^.*?[\r\n]version:[ \t]*"([^"]*)".*$', '$1'))</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
    </PropertyGroup>

    <!-- Locked restore, for every project and every route. Without it a restore
         resolves the newest matching version of every transitive package, so a
         pull request is reviewed against a graph that moves underneath it and a
         compromised transitive release lands with no diff.

         The shared build and test workflows run a plain `dotnet restore`, and
         this repository cannot pass a flag to them, so the property carries the
         locked mode instead and both routes behave the same.

         The cost, stated rather than discovered: changing a package version now
         fails the restore until the lock file is regenerated, with
         `dotnet restore /p:RestoreForceEvaluate=true`. That is the guard
         working. -->
    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode>true</RestoreLockedMode>
    </PropertyGroup>
</Project>
