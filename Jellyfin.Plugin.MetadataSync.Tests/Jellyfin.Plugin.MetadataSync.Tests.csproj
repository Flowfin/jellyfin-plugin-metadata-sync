<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.MetadataSync.Tests</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.MetadataSync.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- The suite targets the same runtimes as the plugin, one per server line,
         so a guard that only holds on one of them is red rather than unread.
         Rolling forward lets a target also run on a machine that carries only a
         newer major runtime, instead of reporting a missing framework as if the
         tests had failed. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- The plugin excludes the server assemblies from its own runtime output,
       because the server supplies them. A test host has no server, so the suite
       takes the same two packages at the same versions with their runtime
       assets, and nothing else from the server. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc4" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.MetadataSync\Jellyfin.Plugin.MetadataSync.csproj" />
  </ItemGroup>

  <!-- The manifest is the thing under test in ManifestTests, so it is copied to
       the output rather than located by walking up from the test binary. -->
  <ItemGroup>
    <None Include="..\build.yaml" Link="build.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The manifest claims a framework and a server ABI, and the thing those
       claims have to agree with is the plugin project file itself. Reading the
       compiled assembly instead would answer a different question: it says what
       the build produced, not what the project declared, and the two diverge
       exactly when the manifest is the one that is wrong. -->
  <ItemGroup>
    <None Include="..\Jellyfin.Plugin.MetadataSync\Jellyfin.Plugin.MetadataSync.csproj"
          Link="Jellyfin.Plugin.MetadataSync.csproj"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The field register is declared once, in the JSON the plugin embeds, and
       the document under docs/ is a rendering of it that a person reads.
       FieldRegisterTests holds the two against each other, so both are copied
       here. Reading the document out of the repository by walking up from the
       test binary would answer a different question on a machine where the
       tests run from somewhere else. -->
  <ItemGroup>
    <None Include="..\docs\field-register.md" Link="field-register.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The comparison rules are declared once in the table the plugin embeds, and
       the document under docs/ carries both a rendering of it and the fixture
       rows the suite runs. ProviderIdentifierTests reads the document, so it is
       copied here for the same reason the field register is. -->
  <ItemGroup>
    <None Include="..\docs\provider-identifiers.md" Link="provider-identifiers.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The conflict rules are declared once, in the table the plugin embeds, and
       the document under docs/ carries both a rendering of it and the fixture
       rows the rule set is argued from. ConflictRuleTests reads the document,
       so it is copied here for the same reason the field register is. -->
  <ItemGroup>
    <None Include="..\docs\conflicts.md" Link="conflicts.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The reference comparison rules are declared once, in the table the plugin
       embeds, and the document under docs/ carries both a rendering of it and
       the fixture rows the suite runs. ReferenceResolutionTests reads the
       document, so it is copied here for the same reason the field register
       is. -->
  <ItemGroup>
    <None Include="..\docs\references.md" Link="references.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The two-step rule for an item identified by its parent and an ordinal is
       declared in the plugin, and docs/matching.md carries both a rendering of
       what each answer means and the fixture rows the suite runs.
       OrdinalResolutionTests reads the document, so it is copied here for the
       same reason the field register is. -->
  <ItemGroup>
    <None Include="..\docs\matching.md" Link="matching.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The endpoint authorization table is declared once, in the document a
       person reads, and EndpointAuthorizationTests holds the plugin's
       controllers against it. It is copied here for the same reason the field
       register is: reading it out of the repository by walking up from the test
       binary would answer a different question on a machine where the tests run
       from somewhere else. -->
  <ItemGroup>
    <None Include="..\docs\endpoints.md" Link="endpoints.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The changelog's classes are carried by three files: the document a person
       reads, the drafter configuration a machine reads, and the label file that
       is the authority for which labels exist at all. ChangelogTests holds the
       three against each other, so all three are copied here for the same reason
       the field register is. -->
  <ItemGroup>
    <None Include="..\docs\changelog.md" Link="changelog.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\.github\release-drafter.yml" Link="release-drafter.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\.github\labels.yaml" Link="labels.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The hygiene gate carries a fourth copy of the changelog's classes, because
       it runs with nothing checked out and cannot read the document. It is
       copied here so ChangelogTests can hold that copy against the other three.

       The four files below it are the ones the gate keys a class to. Each is
       copied under the path the gate names it by, so the leg that asserts a
       keyed path exists is answered by the file rather than by a list beside it.

       The two directions fail in two different places, which is worth knowing
       before somebody looks for one of them in the wrong one. A path added to
       the gate and not copied here reaches the leg and reddens the suite. A file
       that moved and took neither the gate nor this project with it never
       reaches the leg at all: the copy below refuses first, as MSB3030, and the
       build stops there. Both were measured rather than supposed. -->
  <ItemGroup>
    <None Include="..\.github\workflows\pr-hygiene.yml" Link="pr-hygiene.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Jellyfin.Plugin.MetadataSync\Fields\field-register.json"
          Link="subjects\Jellyfin.Plugin.MetadataSync\Fields\field-register.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Jellyfin.Plugin.MetadataSync\Conflicts\conflict-rules.json"
          Link="subjects\Jellyfin.Plugin.MetadataSync\Conflicts\conflict-rules.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\field-register.md" Link="subjects\docs\field-register.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\conflicts.md" Link="subjects\docs\conflicts.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The document telling an operator which server line a package is for
       restates the runtime, the target ABI and the server package that the
       manifest and the plugin project declare. SupportedServersTests holds it
       against both, so it is copied here for the same reason the manifest is:
       reading it by walking up from the test binary would answer a different
       question on a machine where the tests run from somewhere else. -->
  <ItemGroup>
    <None Include="..\docs\supported-servers.md" Link="supported-servers.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The personal data statement pastes the output of one command over the
       plugin project file, and PersonalDataStatementTests re-runs it. The
       project file is already copied above for the manifest, so only the
       document is added here, for the same reason the field register is. -->
  <ItemGroup>
    <None Include="..\docs\personal-data.md" Link="personal-data.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The register of refused tests, which counts itself in its own last
       section and which RefusedTestRegisterTests recomputes that count from.
       It is copied for the same reason the field register is: reading it by
       walking up from the test binary would answer a different question on a
       machine where the tests run from somewhere else.

       The policy beside it, docs/testing.md, is not copied. It defines the
       entry format the reading depends on and nothing here reads it, and a
       file copied because it is related to one that is read is a dependency
       the build carries and no test has. -->
  <ItemGroup>
    <None Include="..\docs\refused-tests.md" Link="refused-tests.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The storage document closes by saying which tables the assembly embeds
       and that nothing writes to a disk, and StorageStatementTests holds both
       against the plugin project file and the plugin's own sources. It is
       copied for the same reason the field register is. -->
  <ItemGroup>
    <None Include="..\docs\storage.md" Link="storage.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The lifecycle document closes by saying what of its three acts is true of
       the tree today, and LifecycleStatementTests holds those claims against
       the plugin's own sources and against the documents copied here. It was
       copied to nothing while it carried the same claim about the store that
       the storage document does, so the change that reddened the one left the
       other describing a tree that had moved. It is copied for the same reason
       the field register is. -->
  <ItemGroup>
    <None Include="..\docs\lifecycle.md" Link="lifecycle.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The lifecycle document also names paths it says this tree does not carry,
       and LifecycleStatementTests asserts each of them is absent. Resolving one
       against the documents copied by name above would answer for a file
       nobody had added a copy line for, so that leg would pass on the day the
       document arrived, which is the one day it exists to fail on. The whole
       directory is copied instead, by a pattern rather than by name, so a
       document added to it is here without anybody editing this file. -->
  <ItemGroup>
    <None Include="..\docs\**\*.md"
          Link="documents\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The reconciliation document pastes a reading of which plugin sources name
       the server's library, and ReconciliationStatementTests re-runs it. That
       paste named one file while the command returned three, and the repair was
       made by somebody running the line for another reason, so the file is
       copied here for the same reason the field register is rather than left as
       the one paste on this board with a drift already behind it and nothing
       reading it. -->
  <ItemGroup>
    <None Include="..\docs\reconciliation.md" Link="reconciliation.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The readme's uninstall section names the files this plugin leaves in its
       data folder, and ReadmeStatementTests holds that list against the file
       names the stores themselves declare. It was copied to nothing while it
       told a reader the store was not built and there was nothing on disk, so
       the changes that built the store reddened the two documents that were
       read and left the one an operator meets first describing a tree from
       before them. It is copied for the same reason the field register is. -->
  <ItemGroup>
    <None Include="..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The security policy opens by saying what is in this tree and what is not,
       and SecurityPolicyTests holds that section against the plugin's own
       sources, which are copied below. It is copied for the same reason the
       field register is: reading it by walking up from the test binary would
       answer a different question on a machine where the tests run from
       somewhere else. -->
  <ItemGroup>
    <None Include="..\SECURITY.md" Link="SECURITY.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The threat model names, per adversary, which defences are in the tree and
       which are owed, and ThreatModelTests holds those entries against the
       plugin's own sources, which are copied below. It is copied for the same
       reason the security policy is: reading it by walking up from the test
       binary would answer a different question on a machine where the tests run
       from somewhere else. -->
  <ItemGroup>
    <None Include="..\docs\threat-model.md" Link="threat-model.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- This project file is what HeadlessPolicyTests reads, so the suite can
       refuse a dependency that would need a display, a running server or the
       network. Reading the resolved package graph instead would answer a
       different question, because a transitive package is not a decision
       anybody made here. -->
  <ItemGroup>
    <None Include="Jellyfin.Plugin.MetadataSync.Tests.csproj"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The two files the coverage route is made of. CoverageReportTests holds the
       run settings to the module filter they exist for, and holds the workflow to
       collecting and then reading the report, because the reading leg has nothing
       to read on a run that does not point it at one. Both are copied for the same
       reason the manifest is: reading them by walking up from the test binary
       would answer a different question on a machine where the tests run from
       somewhere else. -->
  <ItemGroup>
    <None Include="..\coverage.runsettings" Link="coverage.runsettings" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\.github\workflows\coverage.yml" Link="coverage.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The publish route is what ReleaseRouteTests reads. The property it holds
       is that the job creating the release waits on every job that produces an
       asset, which is one line in that file and reads as scheduling rather than
       as a refusal. It is copied for the same reason the coverage workflow is:
       the route has never run, so the file is the only thing there is to
       judge. -->
  <ItemGroup>
    <None Include="..\.github\workflows\publish.yaml" Link="publish.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- DefaultLevelLoggingTests reads the plugin's source text, because the rule
       it holds up is about what a logging call was written to say. The compiled
       assembly cannot answer that: a message template is a constant in the
       metadata whether or not a value was passed beside it, and the placeholder
       names are the whole subject.

       The glob is deliberate rather than a list. A source file added to the
       plugin is judged without anybody remembering to add it here, which is the
       direction that fails closed. bin and obj are excluded because generated
       assembly attributes are not code anybody wrote. -->
  <ItemGroup>
    <None Include="..\Jellyfin.Plugin.MetadataSync\**\*.cs"
          Exclude="..\Jellyfin.Plugin.MetadataSync\bin\**\*.cs;..\Jellyfin.Plugin.MetadataSync\obj\**\*.cs"
          Link="plugin-sources\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
