<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The sources are named here so a package cannot arrive from a source
       nobody chose. clear drops anything a machine-level or user-level
       NuGet.config would otherwise add, which is the case this file exists
       for: a build that restores identically on a developer machine and on a
       runner, rather than one that inherits whatever each has configured. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <!-- Every package comes from the one declared source. A second source
         added later has to say which packages it may serve before it serves
         any. -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
