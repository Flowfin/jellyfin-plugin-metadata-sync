<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.MetadataSync</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.MetadataSync</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" >
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <!-- The field register ships inside the assembly. A register sitting beside
       the assembly is a file an operator can edit, and the whole point of the
       register is that the set of fields this plugin may write is not editable
       per installation. -->
  <!-- The provider identifier comparison table ships inside the assembly for the
       same reason the field register does: a rule an operator can edit per
       installation is not a rule. -->
  <ItemGroup>
    <None Remove="Matching\provider-identifiers.json" />
    <EmbeddedResource Include="Matching\provider-identifiers.json" LogicalName="Jellyfin.Plugin.MetadataSync.Matching.provider-identifiers.json" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Fields\field-register.json" />
    <EmbeddedResource Include="Fields\field-register.json" LogicalName="Jellyfin.Plugin.MetadataSync.Fields.field-register.json" />
  </ItemGroup>

  <!-- The conflict rules ship inside the assembly for the third time the same
       reason applies: a rule an operator can edit per installation is not a
       rule. It matters more here than for the other two, because these rows
       decide whose value survives when two libraries disagree. -->
  <ItemGroup>
    <None Remove="Conflicts\conflict-rules.json" />
    <EmbeddedResource Include="Conflicts\conflict-rules.json" LogicalName="Jellyfin.Plugin.MetadataSync.Conflicts.conflict-rules.json" />
  </ItemGroup>

  <!-- The reference comparison table ships inside the assembly for the fourth
       time the same reason applies. This one decides whether two spellings of
       one person's name are one person, which is not a thing to leave editable
       per installation. -->
  <ItemGroup>
    <None Remove="References\reference-comparison.json" />
    <EmbeddedResource Include="References\reference-comparison.json" LogicalName="Jellyfin.Plugin.MetadataSync.References.reference-comparison.json" />
  </ItemGroup>

</Project>
