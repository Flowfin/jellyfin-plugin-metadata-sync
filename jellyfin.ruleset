<?xml version="1.0" encoding="utf-8"?>
<!-- The analyzer rules for every project in this repository.

     AnalysisMode is AllEnabledByDefault in Directory.Build.props, so a rule
     absent from this file is on. This file is only the exceptions, and each one
     carries the reason it is an exception here, in this repository. Those
     reasons are this repository's own judgement written now. The set of rule
     ids was inherited from the project template and the template gave no
     reasons, so nothing below is a report of why somebody else turned a rule
     off.

     Action="None" means the rule never runs. Action="Info" means it reports and
     does not fail the build, which is the setting for a rule worth reading and
     not worth blocking on. Neither is reached by lowering AnalysisMode. -->
<RuleSet Name="Rules for Jellyfin.Plugin.MetadataSync" Description="Code analysis rules for every project in this repository" ToolsVersion="14.0">
    <Rules AnalyzerId="StyleCop.Analyzers" RuleNamespace="StyleCop.Analyzers">
        <!-- SA1009, SA1011: spacing after a closing parenthesis or bracket.
             The repository formats with .editorconfig and dotnet format, and
             two tools disagreeing about one space produces churn rather than
             defects. -->
        <Rule Id="SA1009" Action="None" />
        <Rule Id="SA1011" Action="None" />
        <!-- SA1101: prefix local calls with 'this.'. The codebase does not,
             and a mixed convention is worse than either one. -->
        <Rule Id="SA1101" Action="None" />
        <!-- SA1108: no comment inside a block statement. The comments this
             repository wants most are the ones next to the branch they
             explain. -->
        <Rule Id="SA1108" Action="None" />
        <!-- SA1118: a parameter may not span lines. The conflict rules and the
             field register produce long literal arguments, and breaking them
             into named locals to satisfy a layout rule hides the shape. -->
        <Rule Id="SA1118" Action="None" />
        <!-- SA1128: constructor initializer on its own line. Layout only, and
             the .editorconfig already decides it. -->
        <Rule Id="SA1128" Action="None" />
        <!-- SA1130: use lambda syntax. A method group is often the clearer
             form and this rule cannot tell the difference. -->
        <Rule Id="SA1130" Action="None" />
        <!-- SA1200: usings inside the namespace. This repository puts them at
             the top of the file, which is what the file-scoped namespace
             declarations it uses make natural. -->
        <Rule Id="SA1200" Action="None" />
        <!-- SA1202, SA1204: members ordered by accessibility and by staticness.
             This repository orders members by what they are for, so a guard
             sits next to the thing it guards. -->
        <Rule Id="SA1202" Action="None" />
        <Rule Id="SA1204" Action="None" />
        <!-- SA1309: no leading underscore on fields. The underscore is this
             repository's marker for a private field and reads better than
             this. as a disambiguator. -->
        <Rule Id="SA1309" Action="None" />
        <!-- SA1413: trailing comma in multi-line initializers. Worth having
             and not worth failing a build over, so it is left to the
             formatter. -->
        <Rule Id="SA1413" Action="None" />
        <!-- SA1512, SA1515: blank lines around single-line comments. Layout
             only, and the two rules together forbid comment shapes this
             repository uses deliberately. -->
        <Rule Id="SA1512" Action="None" />
        <Rule Id="SA1515" Action="None" />
        <!-- SA1600, SA1602: every element and enum member documented. The
             plugin project sets GenerateDocumentationFile, so the compiler
             already requires documentation on public API through CS1591, and
             the test project is not public API. Two rules asking the same
             question with different scopes produces noise in the suite. -->
        <Rule Id="SA1600" Action="None" />
        <Rule Id="SA1602" Action="None" />
        <!-- SA1633: file header. This repository carries its licence in
             LICENSE and its provenance in the manifest, and a header repeated
             in every file is text that drifts. -->
        <Rule Id="SA1633" Action="None" />
    </Rules>

    <Rules AnalyzerId="Microsoft.CodeAnalysis.NetAnalyzers" RuleNamespace="Microsoft.Design">
        <!-- Promoted from warning to error. Each of these is a defect this
             plugin can actually ship, so it fails the build rather than
             joining a list. -->
        <!-- CA1305: an IFormatProvider is required. This plugin compares and
             writes metadata field values, and a culture-dependent conversion
             makes two servers disagree about the same value. -->
        <Rule Id="CA1305" Action="Error" />
        <!-- CA1725: parameter names match the base declaration. The plugin
             implements server interfaces, and a renamed parameter breaks
             callers that pass by name with nothing said. -->
        <Rule Id="CA1725" Action="Error" />
        <!-- CA1727: use PascalCase for named placeholders. A misnamed
             placeholder is how a field value ends up in a log line under a
             name nobody greps for. -->
        <Rule Id="CA1727" Action="Error" />
        <!-- CA1843: do not use WaitAll with a single task. Blocking inside a
             sync pass is how a scheduled task stops being stoppable. -->
        <Rule Id="CA1843" Action="Error" />
        <!-- CA2016: forward the CancellationToken. A pass the server cannot
             stop is the failure the scheduled task exists to avoid. -->
        <Rule Id="CA2016" Action="Error" />
        <!-- CA2254: the logging template is a static expression. An
             interpolated template puts the value into the message text, which
             is exactly where a metadata field value may not go. -->
        <Rule Id="CA2254" Action="Error" />

        <!-- The security categories are not exceptions and are not listed
             here, which under AllEnabledByDefault means every CA2100 to CA5400
             rule is on and fatal. CA5394 was inherited from the template as
             informational and is restored: this plugin has no randomness
             today, and the moment it acquires any, insecure randomness is a
             defect rather than a note. -->

        <!-- Reported and not fatal. Each is a rule whose advice is usually
             right and whose violations here are judgement calls a reader
             should see rather than a build should refuse. -->
        <!-- CA1014: CLSCompliant assemblies. The consumer is one server
             runtime, not an arbitrary CLS consumer. -->
        <Rule Id="CA1014" Action="Info" />
        <!-- CA1024: use a property. A method that computes is honest about
             costing something, and a property that computes is not. -->
        <Rule Id="CA1024" Action="Info" />
        <!-- CA1031: do not catch general exceptions. A sync pass over many
             items has to survive one item, which is a broad catch at exactly
             one place, and the rule cannot tell that place from the others. -->
        <Rule Id="CA1031" Action="Info" />
        <!-- CA1032: standard exception constructors. Constructors nothing
             calls are code nothing tests. -->
        <Rule Id="CA1032" Action="Info" />
        <!-- CA1040: no empty interfaces. A marker interface is sometimes the
             cheapest way to name a set for the container. -->
        <Rule Id="CA1040" Action="Info" />
        <!-- CA1062: validate arguments of public methods. Nullable is enabled
             repository-wide, so the compiler already refuses most of what this
             rule catches and doubling it produces guard clauses no test
             reaches. -->
        <Rule Id="CA1062" Action="Info" />
        <!-- CA1859: use the concrete type rather than the interface, for
             performance. This plugin's cost is network round trips and library
             writes, not virtual dispatch, and the rule fires hardest where
             declaring the abstraction is the point: a test that asserts the
             interface behaves says so by declaring the interface, and a method
             returning IReadOnlyList is refusing to hand out a mutable list. It
             stays visible because on a hot path it would be right. -->
        <Rule Id="CA1859" Action="Info" />
        <!-- CA1508: avoid dead conditional code. It reports false positives on
             code the compiler's own nullable analysis accepts, which is why
             the template carried it as informational too. -->
        <Rule Id="CA1508" Action="Info" />
        <!-- CA1716, CA1720, CA1724: identifiers matching keywords, type names
             or namespaces. This plugin's vocabulary is the domain's, and words
             like Plan, Apply and Sync are the right names. -->
        <Rule Id="CA1716" Action="Info" />
        <Rule Id="CA1720" Action="Info" />
        <Rule Id="CA1724" Action="Info" />
        <!-- CA1805: do not initialize to the default. Writing the default
             explicitly in a configuration type documents the intended value.
             -->
        <Rule Id="CA1805" Action="Info" />
        <!-- CA1812: internal class never instantiated. Everything the server's
             container constructs looks uninstantiated to this rule. -->
        <Rule Id="CA1812" Action="Info" />
        <!-- CA1822: member can be static. Making a member static to satisfy
             this often blocks the substitution the headless suite depends on.
             -->
        <Rule Id="CA1822" Action="Info" />
        <!-- CA2000: dispose before losing scope. It does not follow ownership
             handed to the container, which is where most of this plugin's
             disposables go. -->
        <Rule Id="CA2000" Action="Info" />
        <!-- CA2253: no numeric placeholders. Worth fixing, and a numbered
             placeholder leaks nothing, so it does not stop a build. -->
        <Rule Id="CA2253" Action="Info" />

        <!-- Off entirely. Each is a rule whose premise does not hold here. -->
        <!-- CA1054, CA1055, CA1056, CA2234: URIs as System.Uri rather than
             string. The pairing plane hands this plugin addresses as strings
             and hands them back the same way, so converting at every boundary
             adds parsing that can fail without adding a check. -->
        <Rule Id="CA1054" Action="None" />
        <Rule Id="CA1055" Action="None" />
        <Rule Id="CA1056" Action="None" />
        <Rule Id="CA2234" Action="None" />
        <!-- CA1303: do not pass literals as localized parameters. This plugin
             is not localized, and the rule flags every log message and every
             exception message. -->
        <Rule Id="CA1303" Action="None" />
        <!-- CA1308: normalize to uppercase. Provider identifier comparison
             normalizes to lower case deliberately, which is #32's table, and
             this rule would refuse the whole approach. -->
        <Rule Id="CA1308" Action="None" />
        <!-- CA1848: use LoggerMessage delegates. The gain is allocation on a
             logging path this plugin uses at pass boundaries rather than per
             item, and the cost is a delegate per message. -->
        <Rule Id="CA1848" Action="None" />
        <!-- CA2101: marshaling for P/Invoke strings. There is no P/Invoke in
             this plugin, and the headless policy is one reason there will not
             be. -->
        <Rule Id="CA2101" Action="None" />
    </Rules>
</RuleSet>
